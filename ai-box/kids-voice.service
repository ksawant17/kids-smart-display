[Unit]
Description=Kids Smart Display - voice server (Whisper + Piper) on :8090
After=network-online.target
Wants=network-online.target

[Service]
User=kids-ai
# VOICE_KEY=... (chmod 640, group kids-ai)
EnvironmentFile=/etc/kids-ai/voice.env
# faster-whisper needs the CUDA 12 libraries installed in the venv
Environment=LD_LIBRARY_PATH=/opt/kids-voice/venv/lib/python3.13/site-packages/nvidia/cublas/lib:/opt/kids-voice/venv/lib/python3.13/site-packages/nvidia/cudnn/lib
Environment=STT_MODEL=/opt/kids-voice/whisper/small.en
Environment=TTS_VOICE=/opt/kids-voice/voices/en_US-amy-medium.onnx
ExecStart=/opt/kids-voice/venv/bin/python -I /opt/kids-voice/voice-server.py
Restart=on-failure
RestartSec=5
# home network only (plus this machine)
IPAddressDeny=any
IPAddressAllow=localhost 192.168.10.0/24
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
